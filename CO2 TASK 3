
# Q3: Vehicle Registration Number Validator

def normalise(text):

    text = text.replace(" ", "")
    text = text.replace("-", "")
    text = text.upper()

    return text


def is_valid(reg):

    if len(reg) not in (9, 10):
        return False

    state = reg[0:2]
    district = reg[2:4]
    series = reg[4:-4]
    number = reg[-4:]

    if not state.isalpha():
        return False

    if not district.isdigit():
        return False

    if len(series) not in (1, 2):
        return False

    if not series.isalpha():
        return False

    if not number.isdigit():
        return False

    return True


def format_number(reg):

    return reg[0:2] + " " + reg[2:4] + " " + reg[4:-4] + " " + reg[-4:]


# Six sample inputs
vehicles = [
    "tn 09 ab 1234",
    "KA-01-M-0007",
    "TN9AB1234",
    "TN 22 1234 AB",
    "AP 39 C 5678",
    "MH 12 AB 4567"
]

for raw in vehicles:

    reg = normalise(raw)

    if is_valid(reg):
        print(raw, "->", reg, "->", format_number(reg), "VALID")
    else:
        print(raw, "->", reg, "-> INVALID")
